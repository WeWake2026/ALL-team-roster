# ==============================================================================
# ShiftFlow Pro - Production Caddyfile (Automatic HTTPS & HTTP/3 via Let's Encrypt)
# Compliant with OWASP ASVS v4.0.3, Modern TLS 1.3 & HSTS
# ==============================================================================

shiftflow.msedcl.com {
    # Automatic TLS with Let's Encrypt / ZeroSSL
    tls admin@msedcl.com {
        protocols tls1.2 tls1.3
    }

    # High-Performance Compression (Zstandard & Gzip)
    encode zstd gzip

    # OWASP ASVS Security Headers
    header {
        Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        X-XSS-Protection "1; mode=block"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "geolocation=(), microphone=(), camera=()"
        -Server
    }

    # Static Assets Caching
    handle_path /static/* {
        root * /opt/shiftflow/static
        file_server
        header Cache-Control "public, max-age=2592000, immutable"
    }

    # Reverse Proxy to Uvicorn ASGI Application
    handle {
        reverse_proxy 127.0.0.1:8000 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}

            # Extended timeouts for report downloads
            transport http {
                response_header_timeout 120s
                dial_timeout 30s
            }
        }
    }

    # Request Body Size Limit (25MB for leave proof uploads)
    request_body {
        max_size 25MB
    }

    # Structured JSON Logging
    log {
        output file /var/log/caddy/shiftflow_access.log {
            roll_size 100mb
            roll_keep 10
            roll_keep_for 720h
        }
        format json
    }
}

