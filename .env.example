# ShiftFlow Pro — Environment Configuration Template
# For Render.com, copy these Key-Value pairs into the Environment Variables tab

APP_NAME=ShiftFlow Pro - MSEDCL Workforce Management
APP_ENV=production
DEBUG=False
PORT=8000
HOST=0.0.0.0

# Database Configuration (SQLite default; switches seamlessly to PostgreSQL on Render)
DATABASE_URL=sqlite:///./shiftflow.db

# MongoDB Atlas Integration
MONGODB_URI=mongodb+srv://vivekbo173_db_user:<db_password>@msedcl.yyvse8h.mongodb.net/
MONGODB_DB_NAME=msedcl_workforce

# Security & Authentication Secrets
SECRET_KEY=msedcl_shiftflow_enterprise_production_secret_key_2026_secured
PASSWORD_SALT=msedcl_shiftflow_secure_salt_2026
SESSION_COOKIE_NAME=user_id
SESSION_MAX_AGE_SECONDS=604800

# 24/7 Call Center & Telephony Operations
DEFAULT_LOCATION=Mumbai
MIN_DAILY_STAFF_THRESHOLD=5
DEFAULT_LEAVE_QUOTA=12.0
TOTAL_MAX_BREAK_MINS=60
LUNCH_BREAK_MAX_MINS=45
TEA_BREAK_MAX_MINS=15

# Security Whitelisting
IP_WHITELIST_ENFORCED=DISABLED
