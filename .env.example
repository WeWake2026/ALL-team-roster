# ShiftFlow Pro — Environment Configuration Example
# Copy this file to .env and configure your values

# Application Settings
APP_NAME=ShiftFlow Pro - MSEDCL Workforce Management
APP_ENV=production
DEBUG=False
PORT=8000
HOST=127.0.0.1

# Database Connection (SQLite by default, or PostgreSQL)
# SQLite:
DATABASE_URL=sqlite:///./shiftflow.db
# PostgreSQL Example:
# DATABASE_URL=postgresql://shiftflow_user:SecurePassword123@localhost:5432/shiftflow_db

# Security & Sessions
SECRET_KEY=msedcl_shiftflow_enterprise_secret_key_change_in_production
PASSWORD_SALT=msedcl_shiftflow_secure_salt_2026
SESSION_COOKIE_NAME=user_id
SESSION_MAX_AGE_SECONDS=604800

# Operations Defaults
DEFAULT_LOCATION=Mumbai
MIN_DAILY_STAFF_THRESHOLD=5
DEFAULT_LEAVE_QUOTA=5.0
