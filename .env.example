# ==============================================================================
# SHIFTFLOW PRO - PRODUCTION & RENDER ENVIRONMENT CONFIGURATION (.env)
# ==============================================================================
# Copy and paste these key-value pairs directly into Render.com Dashboard:
# Web Service -> Environment -> Environment Variables -> "Add from .env" / Key-Value
# ==============================================================================

# --- Application Core Settings ---
APP_NAME=ShiftFlow Pro - MSEDCL Workforce Management
APP_ENV=production
DEBUG=False
PORT=8000
HOST=0.0.0.0
PYTHON_VERSION=3.11.8

# --- Security & Authentication Secrets ---
SECRET_KEY=msedcl_shiftflow_enterprise_production_secret_key_2026_secured
PASSWORD_SALT=msedcl_shiftflow_secure_salt_2026
SESSION_COOKIE_NAME=user_id
SESSION_MAX_AGE_SECONDS=604800

# --- Primary SQL Database (SQLite Default or PostgreSQL on Render) ---
# For SQLite (default file included with repo):
DATABASE_URL=sqlite:///./shiftflow.db
# If using Render PostgreSQL, Render auto-sets DATABASE_URL (e.g. postgresql://user:pass@host/db)

# --- MongoDB Atlas Cluster Integration ---
# Replace <db_password> with your actual MongoDB Atlas database password
MONGODB_URI=mongodb+srv://vivekbo173_db_user:<db_password>@msedcl.yyvse8h.mongodb.net/
MONGODB_DB_NAME=msedcl_workforce

# --- 24/7 Operations & Workforce Guardrails ---
DEFAULT_LOCATION=Mumbai
MIN_DAILY_STAFF_THRESHOLD=5
DEFAULT_LEAVE_QUOTA=12.0
TOTAL_MAX_BREAK_MINS=60
LUNCH_BREAK_MAX_MINS=45
TEA_BREAK_MAX_MINS=15

# --- Security Whitelisting Policy ---
# Set to 'ENABLED' for strict office IP enforcement or 'DISABLED' for flexible multi-device access
IP_WHITELIST_ENFORCED=ENABLED
